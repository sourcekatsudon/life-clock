#!/usr/bin/env python
# -*- coding: utf-8 -*-

import sys
import os
import json
import math
from datetime import datetime, timedelta
import calendar
from dateutil.relativedelta import relativedelta
from PyQt5.QtWidgets import (QApplication, QMainWindow, QLabel, 
                           QVBoxLayout, QWidget, QFrame)
from PyQt5.QtGui import (QPainter, QPolygon, QBrush, QPen, QColor, 
                       QFont, QPainterPath, QPixmap, QFontDatabase)
from PyQt5.QtCore import QTimer, QTime, Qt, QPoint, QRect, QSize, QDateTime

class LifeClockWidget(QWidget):
    def __init__(self, config, parent=None):
        super(LifeClockWidget, self).__init__(parent)
        self.config = config
        
        # 設定を読み込む
        self.birth_date = datetime.strptime(config["birth_date"], "%Y-%m-%d")
        self.life_expectancy = config["life_expectancy"]
        self.clock_face_path = os.path.join("images", config["clock_face"])
        
        # デジタル時計用のフォント読み込み（あれば）
        font_path = os.path.join("fonts", "digital.ttf")
        if os.path.exists(font_path):
            QFontDatabase.addApplicationFont(font_path)
            self.digital_font = QFont("Digital-7", 12)
        else:
            self.digital_font = QFont("Courier", 12)
        
        # 時計の針などの色設定
        self.hour_hand_color = QColor(60, 60, 60)
        self.minute_hand_color = QColor(80, 80, 80)
        self.second_hand_color = QColor(200, 0, 0)
        self.text_color = QColor(30, 30, 30)
        self.am_pm_color = QColor(220, 110, 0)
        
        # タイマーを設定（1秒ごとに更新）
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update)
        self.timer.start(1000)
        
        # 時計の背景画像を読み込む
        self.clock_face = QPixmap()
        if os.path.exists(self.clock_face_path):
            self.clock_face.load(self.clock_face_path)
        
        # アプリケーションのスタイル設定
        self.setMinimumSize(400, 500)
        self.setStyleSheet("background-color: #f5f5f5;")
    
    def paintEvent(self, event):
        # 現在の日時を取得
        current_time = datetime.now()
        
        # 描画用の設定
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        
        # 時計のサイズと中心位置を計算
        width = self.width()
        height = self.height()
        center = QPoint(width // 2, height // 2 - 30) # 中心をやや上に調整
        radius = min(width, height - 100) // 2 - 10   # デジタル表示用に余白を確保
        
        # 時計の背景を描画
        if not self.clock_face.isNull():
            painter.drawPixmap(center.x() - radius, center.y() - radius, radius * 2, radius * 2, self.clock_face)
        else:
            # デフォルトの時計の背景を描画
            painter.setPen(QPen(QColor(50, 50, 50), 2))
            painter.setBrush(QBrush(QColor(240, 240, 240)))
            painter.drawEllipse(center, radius, radius)
            
            # 目盛りを描画
            painter.setPen(QPen(QColor(0, 0, 0), 1))
            for i in range(60):
                angle = 6 * i * math.pi / 180
                inner_radius = radius - 10 if i % 5 == 0 else radius - 5
                x1 = center.x() + inner_radius * math.sin(angle)
                y1 = center.y() - inner_radius * math.cos(angle)
                x2 = center.x() + radius * math.sin(angle)
                y2 = center.y() - radius * math.cos(angle)
                painter.drawLine(int(x1), int(y1), int(x2), int(y2))
            
            # 数字を描画
            painter.setFont(QFont("Times", 12, QFont.Bold))
            for i in range(1, 13):
                angle = 30 * i * math.pi / 180
                x = center.x() + (radius - 30) * math.sin(angle) - 10
                y = center.y() - (radius - 30) * math.cos(angle) + 5
                painter.drawText(int(x), int(y), str(i))
        
        # 秒針（1日で1周）
        current_seconds = current_time.hour * 3600 + current_time.minute * 60 + current_time.second
        total_seconds = 24 * 3600  # 1日の秒数
        second_angle = (current_seconds / total_seconds) * 360.0
        self._drawHand(painter, center, second_angle, radius - 20, self.second_hand_color, 1)
        
        # 短針（月に対応。1年で1周 = 30度/月）
        month_angle = (current_time.month - 1 + current_time.day / calendar.monthrange(current_time.year, current_time.month)[1]) * 30
        self._drawHand(painter, center, month_angle, radius - 60, self.minute_hand_color, 3)
        
        # 長針（年齢に対応。生涯で2周 = 寿命80年で720度）
        age = relativedelta(current_time, self.birth_date)
        age_in_years = age.years + age.months / 12 + age.days / 365.25
        hour_angle = (age_in_years / self.life_expectancy) * 720.0  # 2周するため720度
        self._drawHand(painter, center, hour_angle, radius - 90, self.hour_hand_color, 5)
        
        # 時計中心の円を描画
        painter.setPen(Qt.NoPen)
        painter.setBrush(QBrush(QColor(50, 50, 50)))
        painter.drawEllipse(center, 8, 8)
        
        # AM/PMの表示
        self._drawAmPm(painter, center, radius - 50, current_time)
        
        # デジタル情報表示（下部）
        self._drawDigitalInfo(painter, center, radius, width, height, current_time)
    
    def _drawHand(self, painter, center, angle, length, color, width):
        """時計の針を描画する"""
        radian = angle * math.pi / 180.0
        x = center.x() + length * math.sin(radian)
        y = center.y() - length * math.cos(radian)
        
        painter.setPen(QPen(color, width, Qt.SolidLine, Qt.RoundCap))
        painter.drawLine(center.x(), center.y(), int(x), int(y))
    
    def _drawAmPm(self, painter, center, radius, time):
        """AM/PMの表示を描画する"""
        is_am = time.hour < 12        text = "AM" if is_am else "PM"
        x = center.x() - 15
        y = center.y() - radius // 2
        
        painter.setFont(QFont("Arial", 12, QFont.Bold))
        painter.setPen(self.am_pm_color)
        painter.drawText(x, y, 30, 20, Qt.AlignCenter, text)
    
    def _drawDigitalInfo(self, painter, center, radius, width, height, current_time):
        """下部のデジタル情報を表示する"""
        # 情報表示用の枠を描画
        rect = QRect(10, center.y() + radius + 10, width - 20, height - (center.y() + radius) - 20)
        painter.setPen(QPen(QColor(80, 80, 80), 2))
        painter.setBrush(QBrush(QColor(0, 0, 0, 180)))  # 黒背景に変更
        painter.drawRoundedRect(rect, 10, 10)
        
        # フォントの設定
        painter.setFont(self.digital_font)
        painter.setPen(QColor(10, 220, 10))  # デジタル緑色
        
        # 年月日、時刻、曜日を表示
        date_str = current_time.strftime("%Y年%m月%d日")
        time_str = current_time.strftime("%H:%M:%S")
        weekday_str = ["月", "火", "水", "木", "金", "土", "日"][current_time.weekday()]
        date_time_text = f"{date_str} ({weekday_str}) {time_str}"
        
        # 誕生日からの経過
        diff = relativedelta(current_time, self.birth_date)
        age_text = f"年齢: {diff.years}年{diff.months}ヶ月{diff.days}日"
        
        # 残り寿命の計算
        life_end_date = self.birth_date + relativedelta(years=self.life_expectancy)
        remaining = relativedelta(life_end_date, current_time)
        remaining_text = f"残り: {remaining.years}年{remaining.months}ヶ月{remaining.days}日{remaining.hours}時間"
        
        # テキスト表示 - 少し大きなフォントサイズに
        big_font = QFont(self.digital_font)
        big_font.setPointSize(14)
        painter.setFont(big_font)
        
        y_offset = rect.top() + 25
        painter.drawText(rect.left() + 10, y_offset, date_time_text)
        
        # 年齢を黄色で
        painter.setPen(QColor(255, 220, 30))
        painter.drawText(rect.left() + 10, y_offset + 30, age_text)
        
        # 残り時間を赤で
        painter.setPen(QColor(255, 50, 50))
        painter.drawText(rect.left() + 10, y_offset + 60, remaining_text)


class LifeClockApp(QMainWindow):
    def __init__(self):
        super(LifeClockApp, self).__init__()
          # 設定ファイルを読み込み
        config_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.json")
        if os.path.exists(config_path):
            with open(config_path, 'r', encoding='utf-8') as f:
                self.config = json.load(f)
        else:
            # デフォルト設定
            self.config = {
                "birth_date": "1990-01-01",
                "life_expectancy": 80,
                "clock_face": "default.png"
            }
        
        # UIをセットアップ
        self.setWindowTitle("人生時計")
        self.setStyleSheet("background-color: #eaeaea;")
        
        # メインウィジェットを作成
        self.clock_widget = LifeClockWidget(self.config)
        
        # ウィジェットをメインウィンドウに配置
        self.setCentralWidget(self.clock_widget)
        self.resize(400, 500)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    clock = LifeClockApp()
    clock.show()
    sys.exit(app.exec_())
